#!/bin/bash
#PBS -N cupy_def
#PBS -q A100
#PBS -l select=1:ncpus=32:mem=64gb
#PBS -l walltime=00:30:00
#PBS -o /home/ralshehri0468/siliqun/benchmarks/cupy_def.out
#PBS -e /home/ralshehri0468/siliqun/benchmarks/cupy_def.err

source /opt/share/anaconda3/2024.06/etc/profile.d/conda.sh 2>/dev/null || \
source /opt/share/anaconda3/2023.09/etc/profile.d/conda.sh 2>/dev/null || \
source ~/miniconda3/etc/profile.d/conda.sh 2>/dev/null || \
{ echo "FATAL: Cannot find conda"; exit 1; }

conda activate quantum_drl_gpu || { echo "FATAL: Cannot activate env"; exit 1; }
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:$LD_LIBRARY_PATH"

echo "=== System ==="
echo "Node: $(hostname)"
nvidia-smi 2>/dev/null | grep -E "CUDA|A100"
echo ""

# Clean up previous broken installs
echo "=== Cleanup ==="
pip uninstall -y cupy-cuda12x cupy-cuda11x cuda-python cuda-bindings 2>&1 | grep -E "Success|not installed"
echo ""

# Install fastrlock first (CuPy 13.x needs it)
echo "=== Install fastrlock ==="
pip install fastrlock 2>&1 | tail -3
echo ""

# Install CuPy 13.3.0 with all deps EXCEPT numpy (to avoid rebuild)
echo "=== Install CuPy 13.3.0 with deps ==="
pip install "cupy-cuda12x==13.3.0" --no-build-isolation 2>&1 | tail -10
echo "EXIT: $?"
echo ""

# Verify
echo "=== Verify CuPy ==="
python3 -c "
import cupy as cp
print(f'CuPy: {cp.__version__}')
print(f'CUDA runtime: {cp.cuda.runtime.runtimeGetVersion()}')
a = cp.array([1.0, 2.0, 3.0])
print(f'GPU test: {a * 2}')
print(f'Device: {cp.cuda.Device().name}')
mem = cp.cuda.Device().mem_info
print(f'GPU Memory: {mem[1]/1e9:.1f} GB total, {mem[0]/1e9:.1f} GB free')
print('CUPY_VERIFIED_OK')
" 2>&1

CUPY_OK=$?
echo ""

if [ $CUPY_OK -ne 0 ]; then
    echo "=== CuPy 13.3.0 failed, trying 13.0.0 ==="
    pip uninstall -y cupy-cuda12x 2>/dev/null
    pip install "cupy-cuda12x==13.0.0" --no-build-isolation 2>&1 | tail -5
    python3 -c "import cupy as cp; print(f'CuPy {cp.__version__} OK'); a=cp.array([1,2,3]); print(a*2)" 2>&1
    CUPY_OK=$?
fi

if [ $CUPY_OK -ne 0 ]; then
    echo "=== All pip attempts failed. Trying full conda install ==="
    pip uninstall -y cupy-cuda12x 2>/dev/null
    # Use conda to install everything together
    conda install -y -c conda-forge cupy cudatoolkit 2>&1 | tail -10
    python3 -c "import cupy as cp; print(f'CuPy {cp.__version__} OK'); a=cp.array([1,2,3]); print(a*2)" 2>&1
    CUPY_OK=$?
fi

# Run benchmark if CuPy works
python3 -c "import cupy" 2>/dev/null
if [ $? -eq 0 ]; then
    echo ""
    echo "=== GPU BENCHMARK ==="
    cd /home/ralshehri0468/siliqun
    python3 benchmarks/benchmark_sv.py --max-qubits 25 --output benchmarks/sv25_gpu_results.json 2>&1
    
    # Save the working setup
    cat > ~/siliqun/benchmarks/activate_gpu.sh << 'ACTIVATE'
#!/bin/bash
source /opt/share/anaconda3/2024.06/etc/profile.d/conda.sh 2>/dev/null || \
source /opt/share/anaconda3/2023.09/etc/profile.d/conda.sh 2>/dev/null
conda activate quantum_drl_gpu
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:$LD_LIBRARY_PATH"
ACTIVATE
    echo "Saved activate_gpu.sh"
else
    echo "CUPY FAILED - ALL METHODS EXHAUSTED"
fi

echo ""
echo "=== DONE ==="
echo "End: $(date)"
