\newlabel{sec:description}{{2}{3}{Software description}{section.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The SiliQun software architecture. This modular framework is divided into four distinct layers: a flexible numerical backend (supporting NumPy and CuPy), a dual simulation core featuring both an MPS engine for 1D chains and a GPU state vector engine for 2D grids, a dedicated physics engine containing calibrated device profiles and noise models, and an uppermost layer that provides a Gymnasium-compatible RL environment.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:architecture}{{1}{4}{The SiliQun software architecture. This modular framework is divided into four distinct layers: a flexible numerical backend (supporting NumPy and CuPy), a dual simulation core featuring both an MPS engine for 1D chains and a GPU state vector engine for 2D grids, a dedicated physics engine containing calibrated device profiles and noise models, and an uppermost layer that provides a Gymnasium-compatible RL environment}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Architectural layers}{4}{subsection.2.1}\protected@file@percent }
\citation{muhonen2014storing}
\citation{yoneda2018quantum}
\citation{geyer2022twoqubit}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces DFS logical subspace projection. Each logical qubit is encoded in three physical electron spins. The projection $\Pi $ maps the physical Hilbert space ($2^{3n}$ dimensions) to the logical subspace ($2^n$ dimensions), reducing the memory requirement for 25 logical qubits from an intractable $2^{75}$ to a manageable $2^{25}$ (512~MB).}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:dfs}{{2}{5}{DFS logical subspace projection. Each logical qubit is encoded in three physical electron spins. The projection $\Pi $ maps the physical Hilbert space ($2^{3n}$ dimensions) to the logical subspace ($2^n$ dimensions), reducing the memory requirement for 25 logical qubits from an intractable $2^{75}$ to a manageable $2^{25}$ (512~MB)}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The SLEDGE 5$\times $5 grid architecture comprising 25 logical qubits (75 physical spins). Each node represents a logical qubit encoded in three physical electron spins. Lines indicate inter-qubit exchange couplings. The full grid requires a state vector of dimension $2^{25} = 33.5$~million.}}{6}{figure.3}\protected@file@percent }
\newlabel{fig:sledge}{{3}{6}{The SLEDGE 5$\times $5 grid architecture comprising 25 logical qubits (75 physical spins). Each node represents a logical qubit encoded in three physical electron spins. Lines indicate inter-qubit exchange couplings. The full grid requires a state vector of dimension $2^{25} = 33.5$~million}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Built-in silicon spin qubit device profiles in SiliQun.}}{6}{table.2}\protected@file@percent }
\newlabel{tab:devices}{{2}{6}{Built-in silicon spin qubit device profiles in SiliQun}{table.2}{}}
