\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Simulation throughput (steps per second) as a function of the number of qubits on the Aziz HPC (Intel Xeon E5-2695 v2 @ 2.40\,GHz). The MPS-based backend maintains nearly constant throughput ($\sim $91K steps/s) from 2 to 16 qubits, while the theoretical statevector scaling degrades exponentially.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:scaling}{{2}{9}{Simulation throughput (steps per second) as a function of the number of qubits on the Aziz HPC (Intel Xeon E5-2695 v2 @ 2.40\,GHz). The MPS-based backend maintains nearly constant throughput ($\sim $91K steps/s) from 2 to 16 qubits, while the theoretical statevector scaling degrades exponentially}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Left: Gate throughput comparison between SiliQun (MPS), Qiskit Aer (statevector), and QuTiP (statevector) on a log scale. Right: SiliQun's speedup factor over both statevector simulators. The MPS advantage grows with system size as statevector methods encounter exponential scaling.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:comparison}{{3}{10}{Left: Gate throughput comparison between SiliQun (MPS), Qiskit Aer (statevector), and QuTiP (statevector) on a log scale. Right: SiliQun's speedup factor over both statevector simulators. The MPS advantage grows with system size as statevector methods encounter exponential scaling}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Comparison of simulation throughput with and without noise channels enabled on the Aziz HPC. The noise overhead (red diamonds, right axis) ranges from 20\% to 39\%, averaging approximately 32\%.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:noise}{{4}{10}{Comparison of simulation throughput with and without noise channels enabled on the Aziz HPC. The noise overhead (red diamonds, right axis) ranges from 20\% to 39\%, averaging approximately 32\%}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Throughput as a function of maximum bond dimension $\chi $ for an 8-qubit system on the Aziz HPC. Throughput remains approximately constant at $\sim $122K steps/s across all tested bond dimensions.}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:bonddim}{{5}{11}{Throughput as a function of maximum bond dimension $\chi $ for an 8-qubit system on the Aziz HPC. Throughput remains approximately constant at $\sim $122K steps/s across all tested bond dimensions}{figure.5}{}}
