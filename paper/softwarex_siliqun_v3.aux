\newlabel{sec:validation}{{3.2}{9}{Example 2: DFS projection validation}{subsection.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces DRL training results using SiliQun. (a) Episode reward and (b) gate fidelity learning curves for a REINFORCE agent trained on 2-qubit Bell state (blue) and 4-qubit GHZ state (red) preparation tasks over 150 episodes. The 2-qubit agent converges to fidelities above 0.99, while the 4-qubit task illustrates the increased difficulty of larger entangled states.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:learning}{{4}{10}{DRL training results using SiliQun. (a) Episode reward and (b) gate fidelity learning curves for a REINFORCE agent trained on 2-qubit Bell state (blue) and 4-qubit GHZ state (red) preparation tasks over 150 episodes. The 2-qubit agent converges to fidelities above 0.99, while the 4-qubit task illustrates the increased difficulty of larger entangled states}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Example 3: GPU performance benchmarks}{10}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces DFS projection validation for a 2-encoded-qubit system (6 physical spins). (a) Perturbative regime: inter-qubit leakage scales as $O(\theta ^2)$ (measured exponent = 2.00), remaining below 2\% for coupling angles under $17^\circ $. (b) Full coupling range: projected fidelity and DFS population as a function of inter-qubit coupling angle. The dashed line marks the perturbative regime boundary. (c) Encoded SWAP verification: the transfer matrix confirms exact encoded state permutation with zero leakage.}}{11}{figure.5}\protected@file@percent }
\newlabel{fig:validation}{{5}{11}{DFS projection validation for a 2-encoded-qubit system (6 physical spins). (a) Perturbative regime: inter-qubit leakage scales as $O(\theta ^2)$ (measured exponent = 2.00), remaining below 2\% for coupling angles under $17^\circ $. (b) Full coupling range: projected fidelity and DFS population as a function of inter-qubit coupling angle. The dashed line marks the perturbative regime boundary. (c) Encoded SWAP verification: the transfer matrix confirms exact encoded state permutation with zero leakage}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces SiliQun GPU benchmark results on NVIDIA A100 (GPU times) vs.\ single-threaded NumPy on AMD EPYC 7763 (CPU times). The crossover point where GPU outperforms CPU occurs at approximately 16 qubits due to kernel launch overhead.}}{11}{table.4}\protected@file@percent }
\newlabel{tab:gpu_bench}{{4}{11}{SiliQun GPU benchmark results on NVIDIA A100 (GPU times) vs.\ single-threaded NumPy on AMD EPYC 7763 (CPU times). The crossover point where GPU outperforms CPU occurs at approximately 16 qubits due to kernel launch overhead}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces GPU acceleration benchmarks for the 25-qubit SiliQun SV engine on an NVIDIA A100. Left: execution time comparison between CPU (NumPy) and GPU (CuPy) backends on a logarithmic scale. Right: GPU speedup factors for each operation. The GPU delivers 30--93$\times $ speedups, reducing a 100-gate DRL episode from 32~seconds to 430~milliseconds.}}{12}{figure.6}\protected@file@percent }
\newlabel{fig:benchmark}{{6}{12}{GPU acceleration benchmarks for the 25-qubit SiliQun SV engine on an NVIDIA A100. Left: execution time comparison between CPU (NumPy) and GPU (CuPy) backends on a logarithmic scale. Right: GPU speedup factors for each operation. The GPU delivers 30--93$\times $ speedups, reducing a 100-gate DRL episode from 32~seconds to 430~milliseconds}{figure.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Computational complexity}{12}{subsection.3.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Computational complexity of the SiliQun SV engine. $n$ denotes the number of encoded qubits. Memory and operation costs refer to the encoded subspace; the full physical space would require $2^{3n}$.}}{12}{table.5}\protected@file@percent }
\newlabel{tab:complexity}{{5}{12}{Computational complexity of the SiliQun SV engine. $n$ denotes the number of encoded qubits. Memory and operation costs refer to the encoded subspace; the full physical space would require $2^{3n}$}{table.5}{}}
